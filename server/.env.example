PORT=3000
JWT_SECRET=change-me-before-a-shared-server
# Leave empty on this computer. Render fills this with the Postgres address.
# DATABASE_URL=
# Set to false on Render so demo clinics, doctors, and patients are not created.
# SEED_DEMO=true
# Optional legacy destination. Appointment messages use the patient's own phone.
# WHATSAPP_TO=
# Optional. Messages stay in the log until both are set.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Optional. Phone push still tries Expo's service without it.
# EXPO_ACCESS_TOKEN=
# Web ops dashboard at /ops. Super-admin phone (does not change the password).
# If the phone has no account yet, also set OPS_ADMIN_PASSWORD (8+ chars) to create one.
# OPS_ADMIN_PHONE=+201092313486
# OPS_ADMIN_PASSWORD=
# OPS_ADMIN_NAME=Ahmed
# Optional comma-separated phones for staff admins (view + approve, cannot stop clinics/users).
# OPS_STAFF_PHONES=

